      data="found" num="1" reduce="mindist"/>
    <contact name="mf_ds_1_object_contact" geom1="mf_ds_collision_1" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="mf_ds_2_object_contact" geom1="mf_ds_collision_2" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="mf_ds_3_object_contact" geom1="mf_ds_collision_3" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="rf_object_contact" geom1="rf_tip" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="rf_ds_1_object_contact" geom1="rf_ds_collision_1" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="rf_ds_2_object_contact" geom1="rf_ds_collision_2" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="rf_ds_3_object_contact" geom1="rf_ds_collision_3" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="th_object_contact" geom1="th_tip" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="th_ds_1_object_contact" geom1="th_ds_collision_1" geom2="object_visual"
      data="found" num="1" reduce="mindist"/>
    <contact name="th_ds_2_object_contact" geom1="th_ds_collision_2" geom2="object_visual"
