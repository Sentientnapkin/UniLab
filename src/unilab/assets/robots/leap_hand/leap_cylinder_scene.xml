  <keyframe>
    <key
      name="home"
      qpos="
        1.2755175 -0.23027008 0.65462 -0.0045021361
        0.96829781 -0.14775903 0.77250643 -0.041147735
        1.3694316 -0.21296087 0.60575128 0.31371423
        0.44001169 1.511415 1.5552151 -0.10033212

        -0.033697539 0.023782898 0.252
        0.99931016 0.0066493863 -0.0059193501 0.036054733
      "
